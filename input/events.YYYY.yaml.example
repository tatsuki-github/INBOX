# コピーして events.2026.yaml のように年を付けて使います。
year: 2026
events:
  - title: 例: 旅行
    date: 2026-08-10
    end_date: 2026-08-12
    all_day: true
    category: 予定
    status: scheduled
    tags: [travel]
    description: 複数日の終日予定

  - title: 例: 面談
    date: 2026-04-01
    all_day: false
    start_time: "14:00"
    end_time: "15:00"
    category: 予定
    status: next
    tags: [work]
    location: 本社
    url: https://example.com/meeting-notes

  # date を省略すると日付なしメモ
  - title: 例: あとで調べること
    category: メモ
    status: inbox
    tags: [research]
    urls:
      - https://example.com/docs
    description: Notion Table ビューで一覧できるメモ

  # 長文は description_file で外部ファイル参照（description と併用可）
  - title: 例: 長文メモ
    category: メモ
    status: inbox
    description_file: input/memos/example-long-memo.txt
    description: 先頭に表示する短い説明

  # 練習メニュー（構造化）
  - title: 例: 岱明夕練
    date: 2026-08-14
    all_day: false
    start_time: "18:00"
    end_time: "19:30"
    category: 予定
    status: scheduled
    tags: [ランニング, いだてん岱明練習, practice:daiming, session:evening]
    practice:
      warmup: 動きづくり
      absentees: [松野, 塚原]
      items:
        - type: interval
          distance_m: 300
          reps: "6-10"
          intensity: RP
          rest_sec: 60
    description: |
      動きづくり
      欠席者 松野、塚原
      300m×6〜10（RP、レスト1分）
